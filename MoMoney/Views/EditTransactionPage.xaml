<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MoMoney.Views.EditTransactionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:MoMoney.Components"
    xmlns:m="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:viewmodel="clr-namespace:MoMoney.Core.ViewModels;assembly=MoMoney.Core"
    Title="Edit Transaction"
    x:DataType="viewmodel:EditTransactionViewModel">

    <!--  main page  -->
    <ScrollView>
        <VerticalStackLayout Margin="10" Spacing="10">

            <!--  shared form: Date, Amount, Account, Category, Subcategory, Payee, Transfer Account  -->
            <components:TransactionFormView
                x:Name="transactionForm"
                Date="{Binding Transaction.Date, Mode=TwoWay}"
                Account="{Binding Account, Mode=TwoWay}"
                Amount="{Binding Transaction.Amount, Mode=TwoWay}"
                Category="{Binding Category, Mode=TwoWay}"
                Subcategory="{Binding Subcategory, Mode=TwoWay}"
                PayeeText="{Binding Transaction.Payee, Mode=TwoWay}"
                TransferAccount="{Binding TransferAccount, Mode=TwoWay}"
                Accounts="{Binding Accounts}"
                Categories="{Binding Categories}"
                Subcategories="{Binding Subcategories}"
                Payees="{Binding Payees}"
                CategoryChangedCommand="{Binding CategoryChangedCommand}"
                IsCategoryEnabled="{Binding IsCategoryEnabled}"
                IsSubcategoryEnabled="{Binding IsSubcategoryEnabled}"
                IsPayeeVisible="{Binding IsPayeeVisible}"
                IsTransferAccountVisible="{Binding IsTransferAccountVisible}" />

            <!--  delete/clear/enter buttons  -->
            <Grid
                x:Name="grdAcceptButtons"
                ColumnDefinitions="*,*,*"
                ColumnSpacing="10">
                <Button
                    x:Name="btnClear"
                    Grid.Column="0"
                    Style="{DynamicResource BtnTertiary}"
                    Command="{Binding ClearCommand}"
                    HeightRequest="45"
                    Text="Clear" />
                <Button
                    x:Name="btnDelete"
                    Grid.Column="1"
                    Style="{DynamicResource BtnError}"
                    Command="{Binding RemoveTransactionCommand}"
                    HeightRequest="45"
                    Text="Delete" />
                <Button
                    x:Name="btnEnter"
                    Grid.Column="2"
                    Style="{DynamicResource BtnPrimary}"
                    Command="{Binding EditTransactionCommand}"
                    CommandParameter="{Binding Path=PayeeText, Source={x:Reference transactionForm}}"
                    HeightRequest="45"
                    Text="Update" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>