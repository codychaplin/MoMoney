<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MoMoney.Views.Settings.LoggingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:MoMoney.Converters"
    xmlns:m="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:models="clr-namespace:MoMoney.Core.Models;assembly=MoMoney.Core"
    xmlns:selectors="clr-namespace:MoMoney.Selectors"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewmodel="clr-namespace:MoMoney.Core.ViewModels.Settings;assembly=MoMoney.Core"
    Title="Logs"
    x:DataType="viewmodel:LoggingViewModel">
    <ContentPage.ToolbarItems>
        <ToolbarItem
            Command="{Binding ToggleExpandCommand}"
            IconImageSource="{
                FontImageSource FontFamily=MaterialRoundedFilled,
                Color={AppThemeBinding Light={StaticResource onPrimaryContainer},
                Dark={StaticResource onPrimaryDark}},
                Glyph={x:Static m:MaterialOutlined.Tune}}" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>

        <converters:NoneToVisibleConverter x:Key="NoneToVisible" />

        <!--  small item template  -->
        <DataTemplate x:Key="Small" x:DataType="models:Log">
            <Grid
                Padding="10,3"
                BackgroundColor="{AppThemeBinding Light={StaticResource surfaceContainerHighest},
                                                  Dark={StaticResource surfaceContainerHighestDark}}"
                RowDefinitions="*,*">
                <Grid.Resources>
                    <Style TargetType="Label">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource onSurface}, Dark={StaticResource outlineDark}}" />
                    </Style>
                </Grid.Resources>
                <Label
                    FontAttributes="Bold"
                    HorizontalOptions="Start"
                    MinimumWidthRequest="170"
                    Text="{Binding Message}" />
                <Label
                    Grid.Row="1"
                    HorizontalOptions="Start"
                    MinimumWidthRequest="100"
                    Text="{Binding Level}" />
                <Label
                    Grid.Row="1"
                    HorizontalOptions="End"
                    HorizontalTextAlignment="End"
                    MinimumWidthRequest="120"
                    Text="{Binding Timestamp, StringFormat='{0:yy-MM-dd HH:mm:ss}'}" />
            </Grid>
        </DataTemplate>

        <!--  large item template  -->
        <DataTemplate x:Key="Large" x:DataType="models:Log">
            <Grid
                Padding="10,5"
                BackgroundColor="{AppThemeBinding Light={StaticResource surfaceContainerHighest},
                                                  Dark={StaticResource surfaceContainerHighestDark}}"
                RowDefinitions="*,*,*">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Path=OpenPopupCommand, Source={RelativeSource AncestorType={x:Type viewmodel:LoggingViewModel}}}" CommandParameter="{Binding LogId}" />
                </Grid.GestureRecognizers>
                <Grid.Resources>
                    <Style TargetType="Label">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource onSurface}, Dark={StaticResource outlineDark}}" />
                    </Style>
                </Grid.Resources>
                <Label
                    HorizontalOptions="Start"
                    MinimumWidthRequest="170"
                    Text="{Binding ClassName}" />
                <Label
                    HorizontalOptions="End"
                    HorizontalTextAlignment="End"
                    MinimumWidthRequest="170"
                    Text="{Binding ExceptionType}" />
                <Label
                    Grid.Row="1"
                    HorizontalOptions="Start"
                    Text="{Binding Message}" />
                <Label
                    Grid.Row="2"
                    HorizontalOptions="Start"
                    MinimumWidthRequest="100"
                    Text="{Binding Level}" />
                <Label
                    Grid.Row="2"
                    HorizontalOptions="End"
                    HorizontalTextAlignment="End"
                    MinimumWidthRequest="120"
                    Text="{Binding Timestamp, StringFormat='{0:yy-MM-dd HH:mm:ss}'}" />
            </Grid>
        </DataTemplate>

        <selectors:LogDataTemplateSelector
            x:Key="LogDataTemplateSelector"
            CheckBox="{x:Reference ChkTileSize}"
            LargeTemplate="{StaticResource Large}"
            SmallTemplate="{StaticResource Small}" />

    </ContentPage.Resources>

    <!--  content  -->
    <Grid Margin="10,5,10,10" RowDefinitions="Auto,*">

        <!--  filters  -->
        <toolkit:Expander IsExpanded="{Binding IsExpanded}">
            <VerticalStackLayout Padding="0,5" Spacing="5">

                <Border
                    Padding="15,0,0,0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource surfaceContainerHighest},
                                                      Dark={StaticResource surfaceContainerHighestDark}}"
                    HeightRequest="50"
                    Stroke="{AppThemeBinding Light={StaticResource outline},
                                             Dark={StaticResource outline}}"
                    WidthRequest="250">
                    <material:CheckBox
                        x:Name="ChkTileSize"
                        CheckChangedCommand="{Binding CheckChangedCommand}"
                        HorizontalOptions="Start"
                        IsChecked="{Binding IsChecked}"
                        LabelPosition="Before"
                        Text="Large Tiles"
                        TextColor="{AppThemeBinding Light={StaticResource onSurface},
                                                    Dark={StaticResource onSurfaceDark}}"
                        Color="{AppThemeBinding Light={StaticResource primary},
                                                Dark={StaticResource primaryDark}}" />
                </Border>

                <!--  filters  -->
                <material:PickerField
                    x:Name="PckLevels"
                    Title="Log Levels"
                    ItemsSource="{Binding Levels}"
                    WidthRequest="250" />

                <material:PickerField
                    x:Name="PckClasses"
                    Title="Classes"
                    ItemsSource="{Binding Classes}"
                    WidthRequest="250" />

                <material:PickerField
                    x:Name="PckExceptions"
                    Title="Exceptions"
                    ItemsSource="{Binding Exceptions}"
                    WidthRequest="250" />

            </VerticalStackLayout>
        </toolkit:Expander>

        <!--  list  -->
        <Border
            Grid.Row="1"
            Margin="0,5,0,0"
            Padding="0">
            <CollectionView
                ItemTemplate="{StaticResource LogDataTemplateSelector}"
                ItemsSource="{Binding LoadedLogs}"
                RemainingItemsThreshold="0"
                RemainingItemsThresholdReachedCommand="{Binding LoadMoreItemsCommand}"
                VerticalScrollBarVisibility="Always">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="2" Orientation="Vertical" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Label
                        Margin="0,10"
                        HorizontalTextAlignment="Center"
                        Text="No Logs Found" />
                </CollectionView.EmptyView>
            </CollectionView>
        </Border>

        <ActivityIndicator Grid.RowSpan="2" IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" />
    </Grid>

</ContentPage>
