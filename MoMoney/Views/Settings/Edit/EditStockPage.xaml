<?xml version="1.0" encoding="utf-8" ?>
<components:CustomContentPage
    x:Class="MoMoney.Views.Settings.Edit.EditStockPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:MoMoney.Components"
    xmlns:m="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:viewmodel="clr-namespace:MoMoney.Core.ViewModels.Settings.Edit;assembly=MoMoney.Core"
    x:DataType="viewmodel:EditStockViewModel">
    <components:CustomContentPage.Triggers>
        <DataTrigger Binding="{Binding IsEditMode}" TargetType="components:CustomContentPage" Value="True">
            <Setter Property="HeaderTitle" Value="Edit Stock" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsEditMode}" TargetType="components:CustomContentPage" Value="False">
            <Setter Property="HeaderTitle" Value="Add Stock" />
        </DataTrigger>
    </components:CustomContentPage.Triggers>

    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="10">

            <!--  symbol  -->
            <material:TextField
                Title="Symbol"
                Icon="{FontImageSource FontFamily=MaterialOutlinedFilled,
                                    Glyph={x:Static m:MaterialOutlined.Label}}"
                Text="{Binding Stock.Symbol}" />

            <!--  market  -->
            <material:PickerField
                x:Name="txtMarket"
                Title="Market"
                Icon="{FontImageSource FontFamily=MaterialRoundedFilled,
                                    Glyph={x:Static m:MaterialOutlined.Storefront}}"
                SelectedItem="{Binding Stock.Market}">
                <material:PickerField.Items>
                    <x:String>TSE</x:String>
                    <x:String>NASDAQ</x:String>
                    <x:String>NYSE</x:String>
                </material:PickerField.Items>
            </material:PickerField>

            <!--  quantity  -->
            <material:TextField
                Title="Quantity"
                Icon="{FontImageSource FontFamily=MaterialRoundedFilled,
                                    Glyph={x:Static m:MaterialOutlined.Tag}}"
                Keyboard="Numeric"
                Text="{Binding Stock.Quantity}" />

            <!--  cost  -->
            <material:TextField
                Title="Cost"
                Icon="{FontImageSource FontFamily=MaterialRoundedFilled,
                                    Glyph={x:Static m:MaterialOutlined.Shopping_cart}}"
                Keyboard="Numeric"
                Text="{Binding Stock.Cost}" />

            <!--  delete/clear/enter buttons  -->
            <components:ActionButtons
                AddCommand="{Binding AddCommand}"
                ClearCommand="{Binding ClearCommand}"
                EditCommand="{Binding EditCommand}"
                IsEditMode="{Binding IsEditMode}"
                RemoveCommand="{Binding RemoveCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</components:CustomContentPage>