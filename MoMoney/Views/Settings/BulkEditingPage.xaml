<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MoMoney.Views.Settings.BulkEditingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:MoMoney.Components"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:viewmodels="clr-namespace:MoMoney.Core.ViewModels.Settings;assembly=MoMoney.Core"
    Title="Bulk Editing"
    x:DataType="viewmodels:BulkEditingViewModel">

    <Grid
        Margin="10"
        ColumnDefinitions="*,*"
        ColumnSpacing="10"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="10">
        <Grid.Resources>
            <Style TargetType="Border">
                <Setter Property="Padding" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray700}}" />
            </Style>
            <Style TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="5" />
            </Style>
            <Style x:Key="OddPicker" TargetType="material:PickerField">
                <Setter Property="InputBackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray150}, Dark={StaticResource Gray600}}" />
            </Style>
            <Style x:Key="EvenPicker" TargetType="material:PickerField">
                <Setter Property="InputBackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray700}}" />
            </Style>
        </Grid.Resources>

        <!--  find values  -->
        <VerticalStackLayout>

            <!--  find title  -->
            <Border Padding="15,0,0,0" HeightRequest="40">
                <Label
                    FontAttributes="Bold"
                    FontSize="16"
                    Text="Find..."
                    VerticalTextAlignment="Center" />
            </Border>

            <!--  find account  -->
            <components:AccountField
                Style="{StaticResource OddPicker}"
                ItemsSource="{Binding Accounts}"
                SelectedItem="{Binding FindAccount, Mode=TwoWay}" />

            <!--  find category / subcategory  -->
            <components:CategorySubcategoryField
                Categories="{Binding Categories}"
                Category="{Binding FindCategory, Mode=TwoWay}"
                CategoryChangedCommand="{Binding FindCategoryChangedCommand}"
                Subcategories="{Binding FindSubcategories}"
                Subcategory="{Binding FindSubcategory, Mode=TwoWay}" />

            <!--  find payee  -->
            <components:PayeeField
                PayeeText="{Binding FindPayee, Mode=TwoWay}"
                Payees="{Binding Payees}" />
        </VerticalStackLayout>

        <!--  replace values  -->
        <VerticalStackLayout Grid.Column="1">

            <!--  replace title  -->
            <Border Padding="15,0,0,0" HeightRequest="40">
                <Label
                    FontAttributes="Bold"
                    FontSize="16"
                    Text="Replace..."
                    VerticalTextAlignment="Center" />
            </Border>

            <!--  replace account  -->
            <components:AccountField
                Style="{StaticResource OddPicker}"
                ItemsSource="{Binding Accounts}"
                SelectedItem="{Binding ReplaceAccount, Mode=TwoWay}" />

            <!--  replace category / subcategory  -->
            <components:CategorySubcategoryField
                Categories="{Binding Categories}"
                Category="{Binding ReplaceCategory, Mode=TwoWay}"
                CategoryChangedCommand="{Binding ReplaceCategoryChangedCommand}"
                Subcategories="{Binding ReplaceSubcategories}"
                Subcategory="{Binding ReplaceSubcategory, Mode=TwoWay}" />

            <!--  replace payee  -->
            <material:TextField
                Title="Payee"
                Style="{StaticResource EvenPicker}"
                Text="{Binding ReplacePayee}" />
        </VerticalStackLayout>

        <Button
            Grid.Row="1"
            BackgroundColor="{AppThemeBinding Light={StaticResource LightBlue},
                                              Dark={StaticResource Blue}}"
            Command="{Binding BulkFindCommand}"
            Text="Find">
            <Button.CommandParameter>
                <x:Boolean>True</x:Boolean>
            </Button.CommandParameter>
        </Button>

        <Button
            Grid.Row="1"
            Grid.Column="1"
            BackgroundColor="{AppThemeBinding Light={StaticResource Primary},
                                              Dark={StaticResource PrimaryDark}}"
            Command="{Binding BulkReplaceCommand}"
            Text="Replace" />

        <Border
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Padding="10">
            <Label LineHeight="1.5" Text="{Binding Info}" />
        </Border>

    </Grid>
</ContentPage>
