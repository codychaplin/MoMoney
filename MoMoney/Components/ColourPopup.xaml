<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:MoMoney.Core.Helpers;assembly=MoMoney.Core"
    xmlns:viewmodels="clr-namespace:MoMoney.Core.ViewModels;assembly=MoMoney.Core"
    x:DataType="viewmodels:ColourPopupViewModel"
    x:Name="this"
    Padding="5"
    HorizontalOptions="Center"
    VerticalOptions="Center"
    BackgroundColor="{AppThemeBinding Light={DynamicResource surface},
                                      Dark={DynamicResource surfaceDark}}"
    x:Class="MoMoney.Components.ColourPopup">
    <CollectionView
        ItemsSource="{Binding ColourGroups}"
        SelectionMode="None"
        HeightRequest="462"
        WidthRequest="210"
        HorizontalOptions="Center"
        VerticalOptions="Center">
        <CollectionView.ItemsLayout>
            <LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="viewmodels:ColorGroup">
                <CollectionView
                    ItemsSource="{Binding Shades}"
                    SelectionMode="None"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    HeightRequest="32"
                    WidthRequest="210">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout ItemSpacing="10" Orientation="Horizontal" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:ColorShade">
                            <Border
                                BackgroundColor="{Binding Color}"
                                HeightRequest="32"
                                StrokeThickness="0"
                                WidthRequest="32">
                                <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference this}, Path=BindingContext.SelectColourCommand}"
                                        CommandParameter="{Binding Hex}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentView>
