<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MoMoney.Components.PageHeader">

    <ContentView.Resources>
        <ResourceDictionary>
            <!-- Bindable Properties are handled in code-behind -->
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid Padding="10"
          BackgroundColor="{AppThemeBinding Light={StaticResource primaryContainer},
                                              Dark={StaticResource primaryDark}}">
        <Label HorizontalOptions="Start"
               Style="{StaticResource lblTitle}"
               TextColor="{AppThemeBinding Light={StaticResource onPrimaryContainer}, Dark={StaticResource onPrimaryDark}}"
               Text="{Binding Title, Source={RelativeSource AncestorType={x:Type ContentView}}}"
               VerticalOptions="Center" />
        
        <Image HeightRequest="30"
               HorizontalOptions="End"
               VerticalOptions="Center"
               Source="{Binding ImageSource, Source={RelativeSource AncestorType={x:Type ContentView}}}"
               WidthRequest="30" />
    </Grid>
</ContentView>
